class Probe:
    """bpftrace, started again with a growing pause whenever it dies. When
    one probe fails to start twice in a row the other is tried."""

    def __init__(self):
        self.proc = None
        self.choice = 0
        self.fails = 0
        self.started = 0.0
        self.retry_at = 0.0
        self.buf = b""

    @property
    def name(self):
        return PROBES[self.choice][0]

    def start(self):
        cmd = [BPFTRACE, "-q", "-B", "line", "--no-warnings", "-e", PROBES[self.choice][1]]
        self.started = time.monotonic()
        try:
            self.proc = subprocess.Popen(cmd, env=CLEAN_ENV, stdin=subprocess.DEVNULL,
                                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                         close_fds=True)
        except OSError:
            self.proc = None
            self.failed()
            return None
        os.set_blocking(self.proc.stdout.fileno(), False)
        self.buf = b""
        return self.proc.stdout

    def failed(self):
        """Note a death, and choose when and how to start again."""
        quick = time.monotonic() - self.started < 30
        self.fails = self.fails + 1 if quick else 1
        if quick and self.fails % 2 == 0:
            self.choice = (self.choice + 1) % len(PROBES)
        pause = min(60, 2 ** min(self.fails, 6))
        self.retry_at = time.monotonic() + pause
        if self.fails in (1, 4, 16):
            warn(f"black-ops listen: bpftrace stopped; trying the {self.name} probe in {pause} s")

    def read(self):
        """Lines the probe printed, or None when it has gone."""
        try:
            data = os.read(self.proc.stdout.fileno(), 65536)
        except BlockingIOError:
            return []
        except OSError:
            data = b""
        if not data:
            return None
        self.buf += data
        *lines, self.buf = self.buf.split(b"\n")
        if len(self.buf) > 65536:
            self.buf = b""
        return [l.decode("utf-8", "replace") for l in lines]

    def stop(self):
        if self.proc is None:
            return
        try:
            self.proc.terminate()
            self.proc.wait(timeout=5)
        except (OSError, subprocess.SubprocessError):
            try:
                self.proc.kill()
            except OSError:
                pass
        try:
            self.proc.stdout.close()
        except OSError:
            pass
        self.proc = None


class Monitor:
    """The varlink subscription to systemd-resolved, opened again with a
    growing pause whenever it closes, as it does when resolved restarts."""

    def __init__(self):
        self.sock = None
        self.buf = VarlinkBuffer()
        self.fails = 0
        self.retry_at = 0.0

    def connect(self):
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC)
            s.settimeout(5)
            s.connect(MONITOR)
            s.sendall(json.dumps(SUBSCRIBE).encode("utf-8") + b"\0")
            s.setblocking(False)
        except OSError:
            self.failed()
            return None
        self.sock = s
        self.buf = VarlinkBuffer()
        return s

    def failed(self):
        self.close()
        self.fails += 1
        pause = min(60, 2 ** min(self.fails, 6))
        self.retry_at = time.monotonic() + pause
        if self.fails in (1, 4, 16):
            warn(f"black-ops listen: lost systemd-resolved's monitor; trying again in {pause} s")

    def read(self):
        """Messages, or None when the connection has closed or answered
        with an error."""
        try:
            data = self.sock.recv(262144)
        except BlockingIOError:
            return []
        except OSError:
            data = b""
        if not data:
            return None
        msgs = self.buf.feed(data)
        for m in msgs:
            if "error" in m:
                return None
        if msgs:
            self.fails = 0
        return msgs

    def close(self):
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = None


