class Listener:
    def __init__(self, conf, signatures, store, now=None):
        self.retention = conf["retention"]
        self.signatures = signatures
        self.store = store
        self.joiner = Joiner()
        self.agg = Aggregate()
        self.procs = ProcCache()
        self.seen_resolve = {}          # segment -> set of (host, addr) already written
        self.started = int(now if now is not None else time.time())
        self.dirty = True
        self.health = {"probe": None, "probeRunning": False, "dnsConnected": False}

    # Events. Each takes the time it happened, so the tests can drive it.

    def on_answers(self, answers, now):
        seg = segment_name(now)
        seen = self.seen_resolve.setdefault(seg, set())
        for host, addr, ttl in answers:
            self.joiner.add(host, addr, ttl, now)
            # One resolve line per name and address per hour is enough to
            # show what was looked up; a line per repeat would only fill RAM.
            if (host, addr) not in seen:
                seen.add((host, addr))
                self.store.queue({"t": int(now), "src": "resolve", "host": host, "addr": addr})

    def on_connect(self, ev, now):
        if not worth_keeping(ev):
            return None
        exe, unit = self.procs.get(ev["pid"], ev["comm"], now)
        full = {"t": int(now), "src": "connect", "pid": ev["pid"], "comm": ev["comm"],
                "exe": exe, "unit": unit, "uid": ev["uid"],
                "host": self.joiner.lookup(ev["addr"], now), "addr": ev["addr"],
                "port": ev["port"]}
        self.agg.add(full)
        self.store.queue(full)
        self.dirty = True
        return full

    def prune(self, now):
        """Once an hour: drop and wipe what has passed the retention."""
        old = set(expired(self.store.segments(), now, self.retention))
        old |= set(expired(list(self.agg.by_segment), now, self.retention))
        self.store.remove(sorted(old))
        self.agg.drop(old)
        for seg in old:
            self.seen_resolve.pop(seg, None)
        current = segment_name(now)
        for seg in [s for s in self.seen_resolve if s != current]:
            del self.seen_resolve[seg]
        self.joiner.expire(now)
        self.dirty = True
        return sorted(old)

    def purge(self):
        self.agg.clear()
        self.joiner.clear()
        self.seen_resolve.clear()
        self.store.purge()
        self.dirty = True

    def reload(self, now):
        """After a restart with the store on disk, count what is kept."""
        for name in self.store.segments():
            load_segment_lines(self.store.read_segment(name), self.agg, name)
        self.prune(now)

    def view(self, now):
        return build_view(self.agg, self.signatures, now, self.retention, self.started, self.health)

    def write_view(self, now):
        self.store.write_view(self.view(now))
        self.dirty = False


def run():
    conf = parse_conf(read_small(CONF))
    signatures = load_signatures(read_small(SIGNATURES))
    store = Store(RUN_DIR, KEEP_DIR, conf["keep"], account_gid(conf["account"]))
    os.umask(0o077)
    store.prepare()
    lst = Listener(conf, signatures, store)
    if conf["keep"]:
        lst.reload(time.time())
    lst.write_view(time.time())

    sel = selectors.DefaultSelector()
    wake_r, wake_w = os.pipe2(os.O_NONBLOCK | os.O_CLOEXEC)
    signal.set_wakeup_fd(wake_w, warn_on_full_buffer=False)
    flags = {"purge": False, "stop": False}
    signal.signal(signal.SIGUSR1, lambda *_: flags.__setitem__("purge", True))
    signal.signal(signal.SIGTERM, lambda *_: flags.__setitem__("stop", True))
    signal.signal(signal.SIGINT, lambda *_: flags.__setitem__("stop", True))
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    sel.register(wake_r, selectors.EVENT_READ, "wake")

    probe, mon = Probe(), Monitor()
    flush_every = FLUSH_DISK if conf["keep"] else FLUSH_RUN
    # Connections wait a moment before they are joined, so an answer that
    # reaches this process a little after the connect it led to still names it.
    held = []
    last_flush = time.monotonic()
    hour_at = next_hour(time.time())

    try:
        while not flags["stop"]:
            mono = time.monotonic()
            if probe.proc is None and mono >= probe.retry_at:
                out = probe.start()
                if out is not None:
                    sel.register(out, selectors.EVENT_READ, "probe")
            if mon.sock is None and mono >= mon.retry_at:
                s = mon.connect()
                if s is not None:
                    sel.register(s, selectors.EVENT_READ, "dns")
            health = {"probe": probe.name, "probeRunning": probe.proc is not None,
                      "dnsConnected": mon.sock is not None}
            if health != lst.health:
                lst.health = health
                lst.dirty = True

            # Sleep until something arrives, or until the next thing due:
            # a flush if there is anything to flush, a retry, or the hour.
            waits = [max(0.0, hour_at - time.time())]
            if lst.dirty or store.pending:
                waits.append(max(0.0, last_flush + flush_every - mono))
            if probe.proc is None:
                waits.append(max(0.0, probe.retry_at - mono))
            if mon.sock is None:
                waits.append(max(0.0, mon.retry_at - mono))
            if held:
                waits.append(max(0.0, held[0][0] + JOIN_DELAY - mono))
            ready = sel.select(timeout=min(waits) + 0.05)
            # Answers first, for the same reason connections are held.
            ready.sort(key=lambda kv: kv[0].data != "dns")
            for key, _ in ready:
                now = time.time()
                if key.data == "wake":
                    try:
                        while os.read(wake_r, 64):
                            pass
                    except BlockingIOError:
                        pass
                elif key.data == "probe":
                    lines = probe.read()
                    if lines is None:
                        sel.unregister(key.fileobj)
                        probe.stop()
                        probe.failed()
                        continue
                    for line in lines:
                        ev = parse_probe_line(line)
                        if ev is not None and worth_keeping(ev):
                            held.append((time.monotonic(), ev, now))
                    probe.fails = 0 if time.monotonic() - probe.started > 30 else probe.fails
                elif key.data == "dns":
                    msgs = mon.read()
                    if msgs is None:
                        sel.unregister(key.fileobj)
                        mon.failed()
                        continue
                    for m in msgs:
                        lst.on_answers(parse_query_result(m), now)

            mono = time.monotonic()
            while held and held[0][0] + JOIN_DELAY <= mono:
                _, ev, t = held.pop(0)
                lst.on_connect(ev, t)
            now = time.time()
            if flags["purge"]:
                held.clear()
                flags["purge"] = False
                lst.purge()
                lst.write_view(now)
                last_flush = time.monotonic()
            # After a suspend the clock has jumped, which this catches too.
            if now >= hour_at:
                store.flush()
                lst.prune(now)
                hour_at = next_hour(now)
            if time.monotonic() - last_flush >= flush_every and (lst.dirty or store.pending):
                store.flush()
                lst.write_view(now)
                last_flush = time.monotonic()
    finally:
        probe.stop()
        mon.close()
        try:
            store.flush()
        except OSError:
            pass
    return 0


def main():
    if os.geteuid() != 0:
        print("black-ops listen: this runs as root, from its service", file=sys.stderr)
        return 1
    try:
        return run()
    except OSError as exc:
        warn(f"black-ops listen: stopped: {exc.strerror or type(exc).__name__}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
